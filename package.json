{
  "name": "my-astro-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:dynamic": "astro dev --port 4321",
    "dev:both": "node scripts/launch-sites.mjs",
    "build": "astro build",
    "build:static": "astro build --config astro.config.static.mjs",
    "preview": "astro preview",
    "preview:static": "astro preview --config astro.config.static.mjs --port 4322",
    "astro": "astro",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/node": "^11.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript-eslint": "^8.72.0"
  }
}
