---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html><html lang="en"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head><body><Header /><main>
<section class="hero"><div class="hero-copy"><p class="eyebrow">Issue 01 · 2026</p><h1>Make space<br /><em>for better work.</em></h1><p class="hero-lede">A personal field guide to learning in public, building useful systems, and staying curious along the way.</p><a class="button" href="/blog">Explore the journal <span>↗</span></a></div><div class="hero-art" aria-hidden="true"><span class="orb orb-one"></span><span class="orb orb-two"></span><span class="orb orb-three"></span><span class="hero-stamp">KEEP<br />GOING</span></div></section>
<section class="home-section"><div class="section-heading"><div><p class="kicker">Latest dispatches</p><h2>Ideas worth<br />keeping close.</h2></div><a class="text-link" href="/blog">View all notes <span>→</span></a></div><div class="post-grid">{posts.slice(0,3).map((post,index) => <article class:list={['post-card', index === 0 && 'featured']}><div class="post-number">0{index+1}</div><p class="post-date"><FormattedDate date={post.data.pubDate} /></p><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="card-link" href={`/blog/${post.id}/`}>Read note <span>↗</span></a></article>)}</div></section>
<section class="practice-banner"><div><p class="kicker">A different kind of practice</p><h2>Turn an idea<br />into a rhythm.</h2></div><a class="button secondary" href="/bass">Enter the practice room <span>↗</span></a></section>
</main><Footer /></body></html>
<style>
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center;min-height:520px;border-bottom:1px solid var(--line)}.hero h1{margin:18px 0 24px;font-weight:800}.hero h1 em{font-style:normal;color:var(--orange)}.hero-lede{max-width:460px;color:var(--muted);font-size:1.1rem;margin-bottom:32px}.hero-art{min-height:420px;border-radius:28px;background:var(--deep);position:relative;overflow:hidden}.orb{position:absolute;border-radius:50%;filter:blur(1px)}.orb-one{width:330px;height:330px;right:-60px;top:-55px;background:var(--lime)}.orb-two{width:280px;height:280px;left:-70px;bottom:-40px;background:var(--orange);mix-blend-mode:screen}.orb-three{width:150px;height:150px;left:35%;top:34%;background:#84a8ff;mix-blend-mode:screen}.hero-stamp{position:absolute;right:25px;bottom:24px;color:white;border:1px solid rgba(255,255,255,.4);border-radius:50%;width:92px;height:92px;display:grid;place-items:center;text-align:center;font:500 10px/1.2 'DM Mono',monospace;transform:rotate(12deg)}.home-section{padding:110px 0}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:38px}.section-heading h2{margin:10px 0 0}.text-link,.card-link{font-weight:700;text-decoration:none}.text-link{color:var(--orange)}.post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.post-card{min-height:315px;padding:25px;background:var(--card);border:1px solid var(--line);border-radius:18px;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.post-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.post-number{font:500 12px 'DM Mono',monospace;color:var(--orange)}.post-date{margin:42px 0 12px;font:11px 'DM Mono',monospace;color:var(--muted);text-transform:uppercase}.post-card h3{margin-bottom:12px}.post-card h3 a{text-decoration:none}.post-card>p:not(.post-date){font-size:.9rem;color:var(--muted)}.card-link{margin-top:auto;font-size:.85rem}.practice-banner{padding:48px 55px;border-radius:22px;background:var(--lime);display:flex;justify-content:space-between;align-items:center}.practice-banner h2{margin:10px 0 0}.practice-banner .button.secondary{border-color:var(--ink)}@media(max-width:760px){.hero{grid-template-columns:1fr;padding:35px 0 55px}.hero-art{min-height:260px}.post-grid{grid-template-columns:1fr}.section-heading{align-items:start;gap:20px;flex-direction:column}.practice-banner{padding:30px;display:block}.practice-banner .button{margin-top:25px}}
</style>
