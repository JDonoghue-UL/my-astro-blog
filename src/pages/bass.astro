---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Interactive Bass" description="Play an interactive bass guitar in your browser." />
	</head>
	<body>
		<Header />
		<main class="bass-page">
			<section class="intro">
				<p class="eyebrow">The practice room</p>
				<h1>Interactive bass</h1>
				<p>Click a fret, pluck a string, or use your keyboard to play. Tune-up: standard E-A-D-G.</p>
			</section>

			<section class="instrument" aria-label="Interactive bass guitar">
				<div class="instrument-toolbar">
					<div>
						<strong id="note-display">Ready to play</strong>
						<span id="status-display">Choose a fret or press a key</span>
					</div>
					<button class="audio-button" id="audio-button" type="button">Enable sound</button>
				</div>

				<div class="neck" id="neck">
					<div class="nut" aria-hidden="true"></div>
					<div class="fret-numbers" aria-hidden="true">
						<span>Open</span>
						{Array.from({ length: 12 }, (_, index) => <span>{index + 1}</span>)}
					</div>
					{
						[
							{ name: 'G', midi: 43, key: 'q', thickness: 'thin' },
							{ name: 'D', midi: 38, key: 'a', thickness: 'medium' },
							{ name: 'A', midi: 33, key: 'z', thickness: 'thick' },
							{ name: 'E', midi: 28, key: 'x', thickness: 'thickest' },
						].map((string) => (
							<div class="string-row" data-string={string.name} data-midi={string.midi} data-key={string.key}>
								<div class="string-label">
									<strong>{string.name}</strong>
									<small>{string.key.toUpperCase()}</small>
								</div>
								<div class="fretboard">
									<button class="fret open-fret" type="button" data-fret="0" aria-label={`Play open ${string.name} string`}>
										<span class={`string ${string.thickness}`}></span>
										<span class="fret-marker"></span>
									</button>
									{
										Array.from({ length: 12 }, (_, index) => (
											<button
												class="fret"
												type="button"
												data-fret={index + 1}
												aria-label={`Play ${string.name} string at fret ${index + 1}`}
											>
												<span class={`string ${string.thickness}`}></span>
												<span class="fret-marker"></span>
											</button>
										))
									}
								</div>
							</div>
						))
					}
				</div>
			</section>

			<section class="controls">
				<div>
					<h2>Keyboard controls</h2>
					<p>Use the open-string keys to play each string, or use the fret keys below to play fretted notes.</p>
				</div>
				<div class="key-map" aria-label="Keyboard shortcuts">
					{['1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '='].map((key, index) => (
						<span><kbd>{key}</kbd><small>Fret {index + 1}</small></span>
					))}
					<span><kbd>Q</kbd><small>G open</small></span>
					<span><kbd>A</kbd><small>D open</small></span>
					<span><kbd>Z</kbd><small>A open</small></span>
					<span><kbd>X</kbd><small>E open</small></span>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const audioButton = document.querySelector('#audio-button');
	const noteDisplay = document.querySelector('#note-display');
	const statusDisplay = document.querySelector('#status-display');
	const neck = document.querySelector('#neck');
	const keyboardFretKeys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '='];
	const openStringKeys = { q: 'G', a: 'D', z: 'A', x: 'E' };
	const openStringMidi = { E: 28, A: 33, D: 38, G: 43 };
	const noteNames = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
	let audioContext;

	const getAudioContext = () => {
		audioContext ??= new AudioContext();
		if (audioContext.state === 'suspended') audioContext.resume();
		return audioContext;
	};

	const playNote = (midi, label, button) => {
		const context = getAudioContext();
		const now = context.currentTime;
		const oscillator = context.createOscillator();
		const filter = context.createBiquadFilter();
		const gain = context.createGain();
		const frequency = 440 * 2 ** ((midi - 69) / 12);

		oscillator.type = 'sawtooth';
		oscillator.frequency.setValueAtTime(frequency, now);
		filter.type = 'lowpass';
		filter.frequency.setValueAtTime(1800, now);
		filter.Q.setValueAtTime(1.2, now);
		gain.gain.setValueAtTime(0.0001, now);
		gain.gain.exponentialRampToValueAtTime(0.45, now + 0.015);
		gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.3);
		oscillator.connect(filter).connect(gain).connect(context.destination);
		oscillator.start(now);
		oscillator.stop(now + 1.35);

		const note = `${noteNames[midi % 12]}${Math.floor(midi / 12) - 1}`;
		noteDisplay.textContent = `${label} · ${note}`;
		statusDisplay.textContent = 'Plucked';
		button?.classList.add('playing');
		window.setTimeout(() => button?.classList.remove('playing'), 180);
	};

	const playFret = (row, fret) => {
		const stringName = row.dataset.string;
		const midi = Number(row.dataset.midi) + fret;
		const button = row.querySelector(`[data-fret="${fret}"]`);
		playNote(midi, `${stringName} string · fret ${fret === 0 ? 'open' : fret}`, button);
	};

	neck?.addEventListener('click', (event) => {
		const target = event.target.closest('.fret');
		if (!target) return;
		playFret(target.closest('.string-row'), Number(target.dataset.fret));
	});

	audioButton?.addEventListener('click', () => {
		getAudioContext();
		audioButton.textContent = 'Sound enabled';
		statusDisplay.textContent = 'Ready — click a fret or press a key';
	});

	window.addEventListener('keydown', (event) => {
		if (event.repeat || event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
		const key = event.key.toLowerCase();
		if (openStringKeys[key]) {
			const stringName = openStringKeys[key];
			const row = neck.querySelector(`[data-string="${stringName}"]`);
			playFret(row, 0);
			return;
		}
		const fretIndex = keyboardFretKeys.indexOf(event.key);
		if (fretIndex < 0) return;
		const rows = [...neck.querySelectorAll('.string-row')];
		playFret(rows[0], fretIndex + 1);
	});
</script>

<style>
	.bass-page {
		width: 1100px;
		max-width: calc(100% - 2em);
	}
	.intro {
		text-align: center;
		margin-bottom: 2em;
	}
	.intro p {
		margin: 0 auto;
		max-width: 620px;
	}
	.eyebrow {
		color: var(--accent);
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.instrument,
	.controls {
		background: rgba(30, 41, 59, 0.8);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 16px;
		box-shadow: var(--box-shadow);
		overflow: hidden;
	}
	.instrument-toolbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1em;
		padding: 1em 1.25em;
		background: rgba(15, 23, 42, 0.7);
	}
	.instrument-toolbar strong,
	.instrument-toolbar span {
		display: block;
	}
	.instrument-toolbar span {
		color: rgb(var(--gray));
		font-size: 0.75em;
	}
	.audio-button {
		border: 1px solid var(--accent);
		border-radius: 999px;
		padding: 0.55em 1em;
		background: transparent;
		color: var(--accent);
		cursor: pointer;
		font: inherit;
		font-size: 0.75em;
	}
	.audio-button:hover {
		background: var(--accent);
		color: var(--page-background);
	}
	.neck {
		position: relative;
		padding: 2.25em 1em 1.5em;
		background: linear-gradient(90deg, #252018, #4a3725 8%, #3c2b1e 92%, #211b17);
	}
	.fret-numbers,
	.string-row {
		display: grid;
		grid-template-columns: 54px repeat(13, minmax(42px, 1fr));
	}
	.fret-numbers {
		margin-left: 0;
		margin-bottom: 0.25em;
		color: #d6bf8c;
		font-size: 0.55em;
		text-align: center;
	}
	.string-label {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		color: #f7e5ba;
	}
	.string-label small {
		color: #d6bf8c;
		font-size: 0.55em;
	}
	.fretboard {
		display: contents;
	}
	.fret {
		position: relative;
		height: 58px;
		border: 0;
		border-right: 2px solid rgba(215, 190, 142, 0.48);
		border-bottom: 1px solid rgba(20, 15, 10, 0.45);
		background: transparent;
		cursor: pointer;
	}
	.open-fret {
		border-left: 5px solid #d6bf8c;
	}
	.fret:hover,
	.fret.playing {
		background: rgba(138, 180, 255, 0.28);
	}
	.string {
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 2px;
		background: linear-gradient(#bebebe, #353535, #efefef);
		box-shadow: 0 0 3px #111;
		pointer-events: none;
	}
	.string.medium {
		height: 3px;
	}
	.string.thick {
		height: 4px;
	}
	.string.thickest {
		height: 5px;
	}
	.fret-marker {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 12px;
		height: 12px;
		border: 2px solid rgba(247, 229, 186, 0.65);
		border-radius: 50%;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}
	.string-row:nth-of-type(4) .fret:nth-child(8) .fret-marker,
	.string-row:nth-of-type(4) .fret:nth-child(10) .fret-marker {
		border-radius: 3px;
	}
	.controls {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 1.5em;
		margin-top: 1.5em;
		padding: 1.25em;
	}
	.controls h2 {
		font-size: 1.25em;
	}
	.controls p {
		margin: 0;
		font-size: 0.8em;
	}
	.key-map {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65em;
		align-items: center;
	}
	.key-map span {
		display: flex;
		flex-direction: column;
		align-items: center;
		color: rgb(var(--gray));
		font-size: 0.55em;
		line-height: 1.2;
	}
	kbd {
		min-width: 2em;
		margin-bottom: 0.25em;
		padding: 0.2em 0.35em;
		border: 1px solid rgb(var(--gray-light));
		border-bottom-width: 3px;
		border-radius: 5px;
		background: var(--page-background);
		color: rgb(var(--black));
		font-size: 1.5em;
		text-align: center;
	}
	@media (max-width: 720px) {
		.fret-numbers,
		.string-row {
			grid-template-columns: 34px repeat(13, minmax(25px, 1fr));
		}
		.fret {
			height: 48px;
		}
		.fret-marker {
			width: 7px;
			height: 7px;
			border-width: 1px;
		}
		.controls {
			grid-template-columns: 1fr;
		}
	}
</style>
