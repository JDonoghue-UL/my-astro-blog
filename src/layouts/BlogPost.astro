---
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, author } = Astro.props;
const authorEntry = author ? await getEntry('authors', author) : undefined;
---
<html lang="en"><head><BaseHead title={title} description={description} /></head><body><Header /><main class="article-page"><article>{heroImage && <Image class="article-image" width={1100} height={500} src={heroImage} alt="" />}<div class="article-head"><p class="eyebrow"><FormattedDate date={pubDate} />{updatedDate && <> · Updated <FormattedDate date={updatedDate} /></>}</p><h1>{title}</h1><p class="article-deck">{description}</p></div><div class="prose"><slot />{authorEntry && <aside class="author-bio"><Image src={authorEntry.data.photo} width={64} height={64} alt={authorEntry.data.name} /><div><strong>{authorEntry.data.name}</strong><p>{authorEntry.data.bio}</p></div></aside>}</div></article></main><Footer /></body></html>
<style>.article-page{max-width:1000px}.article-image{width:100%;max-height:500px;object-fit:cover;border-radius:22px;margin-bottom:65px}.article-head{max-width:800px;margin:0 auto 55px;border-bottom:1px solid var(--line);padding-bottom:42px}.article-head h1{margin:16px 0 20px;font-size:clamp(2.8rem,6vw,5.6rem)}.article-deck{font-size:1.2rem;color:var(--muted);max-width:650px}.article-page .prose{margin:0 auto}.author-bio{display:flex;gap:15px;align-items:center;border-top:1px solid var(--line);margin-top:55px;padding-top:25px}.author-bio img{border-radius:50%;width:64px;height:64px;object-fit:cover}.author-bio p{margin:4px 0 0;color:var(--muted);font-size:.9rem}
</style>
